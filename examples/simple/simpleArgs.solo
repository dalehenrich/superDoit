#!/usr/bin/env superdoit_solo
#
# Example script for superDoit with one argument, that logs in solo and returns   
# a value based on the argument.
#
options
{
SuperDoitRequiredOptionWithRequiredArg long: 'addend' short: 'a'.
}
%
usage
-----
USAGE $basename [--help | -h] [--debug | -D] [--debugGem] --addend=<number> | -a <number> 

DESCRIPTION
  Evaluate the Smalltalk expression: 3+<number> and return the result on stdout.

OPTIONS
  -a, --addend <number>     <number> is a number that will be added to 3.    
  -h, --help                Display usage message.
  -D, --debug               Bring up topaz debugger in the event of a script error.
  --debugGem                If terminal is connected to stdout, bring up debugger. If not,
                            dump stack to stdout and wait for topaz to attach using topaz
                            DEBUGGEM command.

EXAMPLES
  $basename --help
  $basename -D -a 100
  $basename --debugGem --addend=5
  $basename --addend=5
  $basename -a 100
-----
%
doit
(self addend) asNumber + 3
%
